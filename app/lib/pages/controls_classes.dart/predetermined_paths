import 'package:flutter/material.dart';
import 'controls.dart';
import 'dart:async';



class PrederterminedPaths extends StatefulWidget {
  const PrederterminedPaths({super.key});

  @override
  State<PrederterminedPaths> createState() => _PrederterminedPathsState();
}


class _PrederterminedPathsState extends State<PrederterminedPaths> {

  bool buttonsLocked = false;
  int spiralTimer = 10;
  int randomTimer = 4;
  int gridTimer = 3;
  int lineTimer = 2;


  @override
  Widget build(BuildContext context){
    return Column(
      mainAxisAlignment: MainAxisAlignment.center,
      children: [
        SizedBox(
          width: 600,  
          height: 400, 
          child: Card.outlined(
            color: Colors.white,
            surfaceTintColor: Colors.transparent,
            shape: RoundedRectangleBorder(
              borderRadius: BorderRadius.circular(24),
              side: const BorderSide(color: Color.fromARGB(255, 69, 68, 68), width: 1),
            ),

            child: Row(
              children:[
                Expanded(
                  child: Column(
                    mainAxisAlignment: MainAxisAlignment.spaceEvenly,
                    children: [
                      TextButton(
                        onPressed: buttonsLocked ? null:() {
                          setState((){
                            buttonsLocked = true;
                          });

                          Timer(Duration(seconds: spiralTimer), (){
                             setState((){
                              buttonsLocked = false;
                            });
                          });
                            
                          print('Spiral Inwards');

                        },
                        child: const Text('Spiral Inwards')
                      ),
                      TextButton(
                        onPressed: buttonsLocked ? null:() {
                          setState((){
                            buttonsLocked = true;
                          });

                          Timer(Duration(seconds: randomTimer), (){
                             setState((){
                              buttonsLocked = false;
                            });
                          });
                          print('Random Walk');
                        }, 
                        child: const Text('Random Walk')
                      ),
                    ],
                  ),
                ),
                Expanded(
                  child: Column(
                    mainAxisAlignment: MainAxisAlignment.spaceEvenly,
                    children: [ 
                      TextButton(
                        onPressed: buttonsLocked ? null:() {
                          setState((){
                            buttonsLocked = true;
                          });
                          Timer(Duration(seconds: gridTimer), (){
                             setState((){
                              buttonsLocked = false;
                            });
                          });
                          print('Grid Path');
                        }, 
                        child: const Text('Grid Path')
                      ),
                      TextButton(
                        onPressed: buttonsLocked ? null:() {
                          setState((){
                            buttonsLocked = true;
                          });

                          Timer(Duration(seconds: lineTimer), (){
                             setState((){
                              buttonsLocked = false;
                            });
                          });
                          print('Straight Line');
                        }, 
                        child: const Text('Straight Line')
                      )
                    ]
                  ) 
                )
               ]
             )
          ),
        ),
      ],
    );  
  }
}
